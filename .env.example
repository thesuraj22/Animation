# Reference template only. No real credentials belong here.
# Configure hosted values through Sites runtime settings.
# For a standalone Wrangler environment use an ignored .dev.vars file.
COMMERCE_MODE=disabled
# Only rzp_test_ keys are currently accepted; live payments are deliberately blocked.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# JSON object: {"pincodes": {"<approved-six-digit-PIN>": <delivery-charge-in-paise>}, "taxBps": <approved-exclusive-tax-basis-points>}
# Empty means unconfigured, NOT free shipping / zero tax.
DELIVERY_RULES_JSON=
# Enable only after a real support process is ready to handle stored enquiries.
CONTACT_ENABLED=false
